# Sample Terraform Variables
aws_region          = "us-east-1"
project_name        = "cloudops-fullstack"
environment         = "production"
repository_url      = "https://github.com/danish-ali-droid/apex-assesment.git"
repository_ref      = "main"
dockerhub_username  = "your-dockerhub-username"
app_config_secret_name = "cloudops-fullstack/application-config"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
instance_type       = "t2.micro"

node_env = "production"
host_port = 3000
db_host = "postgres"
db_port = 5432
db_user     = "postgres"
db_name     = "librarydb"
# DB_PASSWORD is provided by the DB_PASSWORD GitHub Actions secret.

# Optional: List of admin IPs permitted to SSH (leave empty to enforce AWS SSM Session Manager)
ssh_allowed_cidrs = []
key_name          = ""
