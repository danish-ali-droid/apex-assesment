# Sample Terraform Variables
aws_region          = "us-east-1"
project_name        = "cloudops-fullstack"
environment         = "production"
repository_url      = "https://github.com/danish-ali-droid/apex-assesment.git"
repository_ref      = "main"
dockerhub_username  = "your-dockerhub-username"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
instance_type       = "t2.micro"

db_user     = "postgres"
db_name     = "librarydb"

# Optional: List of admin IPs permitted to SSH (leave empty to enforce AWS SSM Session Manager)
ssh_allowed_cidrs = []
key_name          = ""
